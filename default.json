{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":timezone(Asia/Tokyo)", ":automergeMinor", "schedule:nonOfficeHours"],
  "npmrc": "@avita-co-jp:registry=https://npm.pkg.github.com/",
  "rebaseWhen": "conflicted",
  "patch": {
    "additionalBranchPrefix": "patch/"
  },
  "minor": {
    "additionalBranchPrefix": "minor/"
  },
  "packageRules": [
    {
      "description": "Wait 14 days before updating npm packages",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "GitHub Actionsの更新を自動マージしない",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "description": "developを参照するavita-co-jpのGitHub ActionsのSHA更新を無効化",
      "enabled": false,
      "matchCurrentValue": "develop",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^avita-co-jp\\//"]
    }
  ],
  "major": {
    "draftPR": true,
    "rebaseWhen": "never",
    "additionalBranchPrefix": "major/"
  }
}

{
  prConcurrentLimit: 5, // 同時オープンPR数を制限
  prHourlyLimit: 5, // 1時間あたりの新規PR作成を制限
  separateMinorPatch: true, // patch と minor は必ず分離
  separateMultipleMajor: true, // major が複数同時に来ても一括にしない
  schedule: ["every weekend"], // 週末にバッチ
  extends: [
    "group:monorepos", // 同一モノレポの依存はまとめる（個別リリースが前提のものは別途除外）
  ],

  ignorePaths: [".node-version"],
  // avacom 共通で当面追従しない依存更新を止める。
  // - @avita-co-jp/design-tokens: v3 は影響範囲が大きく、モノレポ化後に移行計画を立てる
  // - jest / @testing-library/react: テスト基盤の更新影響が複数repoに出るため、計画的に対応する
  // - graphql-codegen-typescript-mock-data: v5.1.2 以降は Node.js >=24 が必要
  // - lint-staged / node / @types/node: Node.js 実行環境に依存するため、各repoの環境更新と合わせて対応する
  // - jest-environment-jsdom: 各repoの jsdom pnpm patch とバージョン連動しており、
  //   意図しない jsdom バージョンに更新されるとパッチが適用できなくなる可能性がある
  // - @storybook/nextjs-vite: 各repoの .storybook/main.ts が内部プラグイン名
  //   （vite-plugin-storybook-nextjs-dynamic 等）に依存した workaround をしており、
  //   アップデートでプラグイン名が変わると壊れる可能性がある
  ignoreDeps: [
    "avita-co-jp/sync-labels-with-repo",
    "@avita-co-jp/design-tokens",
    "jest",
    "@testing-library/react",
    "graphql-codegen-typescript-mock-data",
    "lint-staged",
    "jest-environment-jsdom",
    "@storybook/nextjs-vite",
    "node",
    "@types/node",
  ],

  packageRules: [
    // -----------------------------
    // devDependencies は全て Chromatic をスキップ
    // -----------------------------
    {
      matchDepTypes: ["devDependencies"],
      additionalBranchPrefix: "no-chromatic/",
    },

    // -----------------------------
    // patch は広くまとめて自動マージ
    // -----------------------------
    {
      matchUpdateTypes: ["patch"],
      groupName: "patch-all",
      automerge: true,
      draftPR: false,
      reviewers: [
        "team:avita_avacom_frontend",
        "team:fulltime_avacom_frontend",
      ],
      additionalBranchPrefix: "no-chromatic/",
    },

    // -----------------------------
    // digest / pinDigest 更新はまとめて自動マージ
    // -----------------------------
    {
      matchUpdateTypes: ["digest", "pinDigest"],
      groupName: "digest-all",
      automerge: true,
      draftPR: false,
      reviewers: [
        "team:avita_avacom_frontend",
        "team:fulltime_avacom_frontend",
      ],
      additionalBranchPrefix: "no-chromatic/",
    },

    // ------------------------------------------------------------
    // minor：UI 影響"少"のスタックは週末にバッチでまとめる
    // ------------------------------------------------------------
    {
      matchUpdateTypes: ["minor"],
      excludePackageNames: [
        // 下の「UI影響"大"」グループで扱うものは除外
        "react",
        "react-dom",
        "next",
        "storybook",
        "@storybook/*",
        "chromatic",
        "@chromaui/*",
        "@radix-ui/*",
        "lucide-react",
        "shadcn-ui",
        "storybook-react-i18next",
      ],
      groupName: "minor-batch-weekend",
      schedule: ["every weekend"], // 週末にバッチ
      automerge: true,
      reviewers: [
        "team:avita_avacom_frontend",
        "team:fulltime_avacom_frontend",
      ],
      additionalBranchPrefix: "no-chromatic/",
      draftPR: false,
    },
    // ------------------------------------------------------------
    // minor：UI 影響"大"のライブラリは個別でPRを出す
    // ------------------------------------------------------------
    {
      matchUpdateTypes: ["minor"],
      matchPackageNames: [
        "react",
        "react-dom",
        "next",
        "storybook",
        "@storybook/*",
        "chromatic",
        "@chromaui/*",
        "@radix-ui/*",
        "lucide-react",
        "shadcn-ui",
        "storybook-react-i18next",
      ],
      automerge: true,
      reviewers: [
        "team:avita_avacom_frontend",
        "team:fulltime_avacom_frontend",
      ],
    },

    // ------------------------------------------------------------
    // 当面追従しない major アップデートはPR作成を止める
    // - next: v16 は影響範囲が大きく、モノレポ化後に移行計画を立てる
    // - @apollo/client: v4 は影響範囲が大きく、モノレポ化後に移行計画を立てる
    // - typescript: v7 は影響範囲が大きく、モノレポ化後に移行計画を立てる
    // ref: https://github.com/avita-co-jp/avacom-issues/issues/3099
    // ------------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["next", "@apollo/client", "typescript"],
      enabled: false,
    },

    // ------------------------------------------------------------
    // major は自動マージしない
    // ------------------------------------------------------------
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      autoApprove: true,
      draftPR: false,
      reviewers: [
        "team:avita_avacom_frontend",
        "team:fulltime_avacom_frontend",
      ],
    },
  ],
}
